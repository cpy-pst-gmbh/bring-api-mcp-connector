{% extends 'base.html.twig' %}

{% block title %}{{ title|trans }}{% endblock %}

{% block body %}
    {# The document brings its own headings. Wrapping it in the same card as
       everything else keeps it part of the site rather than a bare page. #}
    <article class="legal rounded-card bg-white p-8 shadow-e3 sm:p-10">
        {{ content|raw }}
    </article>
{% endblock %}
