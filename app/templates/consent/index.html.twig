{% extends 'base.html.twig' %}

{% block title %}{{ 'consent.title'|trans }}{% endblock %}

{% block body %}
    {# Not part of the wizard, so it brings its own card — same shell values as
       `wizard/_layout.html.twig`: rounded-card, white, shadow-e3. #}
    <div class="mx-auto max-w-xl rounded-card bg-white p-8 shadow-e3 sm:p-10">
        <p class="text-sm font-medium uppercase tracking-[0.08em] text-ink-500">
            {{ 'consent.title'|trans }}
        </p>

        <h1 class="mt-4 text-[26px] font-normal leading-tight tracking-tight">
            {{ 'consent.heading'|trans({'%client%': client_name}) }}
        </h1>
        <p class="mt-3 text-base leading-relaxed text-ink-700">
            {{ 'consent.lead'|trans({
                '%client%': client_name,
                '%email%': app.user.userIdentifier,
            }) }}
        </p>

        <div class="mt-8 rounded-action bg-tint p-6 shadow-inset-field">
            <h2 class="text-[15px] font-bold text-ink">{{ 'consent.permissions_heading'|trans }}</h2>
            <ul class="mt-3 space-y-2 text-[15px] leading-normal text-ink-700">
                <li class="flex gap-2"><span aria-hidden="true">·</span> {{ 'consent.permission_read'|trans }}</li>
                <li class="flex gap-2"><span aria-hidden="true">·</span> {{ 'consent.permission_write'|trans }}</li>
            </ul>

            <p class="mt-4 text-sm text-ink-300">
                {{ 'consent.scopes'|trans({'%count%': scopes|length, '%scopes%': scopes|join(', ')}) }}
            </p>
        </div>

        {# Both decisions redirect to claude.ai. Turbo would submit this with
           fetch(), and a fetch cannot follow a redirect to another origin —
           the browser blocks it as a CORS failure and the connector never
           receives its code. A plain form submission navigates instead. #}
        <form method="post" data-turbo="false" class="mt-8 flex flex-wrap gap-4">
            <input type="hidden" name="_token" value="{{ csrf_token('consent') }}">
            <button type="submit" name="decision" value="approve"
                    class="grow rounded-action bg-pink px-6 py-4 text-base font-bold text-white shadow-pink transition-opacity duration-300 hover:opacity-80 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                {{ 'consent.allow'|trans }}
            </button>
            <button type="submit" name="decision" value="deny"
                    class="grow rounded-control border border-ink-100 bg-white px-6 py-4 text-base font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                {{ 'consent.deny'|trans }}
            </button>
        </form>
    </div>
{% endblock %}
