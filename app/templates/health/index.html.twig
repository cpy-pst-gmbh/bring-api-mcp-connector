{#
  Standalone on purpose: extending base.html.twig would pull in the navigation,
  the flash region and the JavaScript importmap. A status page loads when things
  are broken, so it depends on as little as possible — and reading flashes would
  start a session, which this endpoint avoids.
#}
<!DOCTYPE html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex">
        <title>{{ (healthy ? 'health.title_ok' : 'health.title_failed')|trans }}</title>
        {# A coloured dot rather than an emoji: the brand uses exactly one
           pictorial character anywhere, and it is the heart in the footer.
           The colour still lets a monitor read the tab at a glance. #}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><circle cx=%228%22 cy=%228%22 r=%227%22 fill=%22{{ healthy ? '%23262730' : '%23ff7b9c' }}%22/></svg>">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    </head>
    <body class="flex h-full flex-col bg-tint text-ink antialiased">
        <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-14">
            <p class="text-sm font-medium uppercase tracking-[0.08em] text-ink-500">{{ 'app.name'|trans }}</p>

            <div class="mt-4 flex flex-wrap items-center gap-3">
                <span class="inline-flex size-3 rounded-full {{ healthy ? 'bg-ink' : 'bg-pink' }}"
                      aria-hidden="true"></span>
                <h1 class="text-[26px] font-normal leading-tight tracking-tight">
                    {{ (healthy ? 'health.heading_ok' : 'health.heading_failed')|trans }}
                </h1>
            </div>

            <p class="mt-2 text-[15px] text-ink-500">
                {{ 'health.checked_at'|trans({
                    '%date%': checked_at|date('Y-m-d H:i:s'),
                    '%status%': healthy ? '200' : '503',
                }) }}
            </p>

            <ul class="mt-8 divide-y divide-sage-100 overflow-hidden rounded-card bg-white shadow-e2">
                {% for check in checks %}
                    {% set result = check.result %}
                    <li class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1 px-8 py-6">
                        <div class="min-w-0">
                            <p class="text-[15px] font-bold text-ink">{{ check.label|trans }}</p>
                            {% if result.detail %}
                                <p class="mt-1.5 text-[15px] leading-normal text-ink-500">
                                    {{ result.detail|trans(result.detailParameters) }}
                                </p>
                            {% endif %}
                        </div>

                        {# The palette has no green and no red — pink is what
                           this brand uses to mark a problem, so a failed check
                           is pink and everything else is monochrome. #}
                        {% set tone = {
                            'ok': 'bg-ink',
                            'failed': 'bg-pink',
                            'skipped': 'bg-ink-300',
                        } %}
                        <span class="flex shrink-0 items-center gap-2 text-sm font-medium">
                            <span class="inline-flex size-2 rounded-full {{ tone[result.status] }}" aria-hidden="true"></span>
                            {{ ('health.status.' ~ result.status)|trans }}
                        </span>
                    </li>
                {% endfor %}
            </ul>

            <p class="mt-6 text-[15px] text-ink-500">
                {{ 'health.as_json'|trans }}
                <a href="{{ path('app_health', {_format: 'json'}) }}"
                   class="font-medium text-ink underline underline-offset-4 transition-colors duration-300 hover:text-pink">/health.json</a>
            </p>
        </main>
    </body>
</html>
