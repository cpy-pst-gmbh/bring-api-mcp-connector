# Copy to .env next to docker-compose.yml and fill in.

# Pin both halves to one build. `latest` works but lets a restart pick up a
# different version; a sha tag from the Actions run cannot drift.
IMAGE_TAG="latest"

# Public HTTPS addresses, without a trailing slash.
BASE_URL="https://bring.example.de"
MCP_BASE_URL="https://bring-mcp.example.de"

# docker run --rm --entrypoint php \
#     ghcr.io/cpy-pst-gmbh/bring-api-mcp-connector/app:latest \
#     bin/console app:credentials:generate-key
BRING_CREDENTIALS_KEY=""

# openssl rand -hex 16, each of them
APP_SECRET=""
OAUTH_PASSPHRASE=""
OAUTH_ENCRYPTION_KEY=""

# The proxy's address as the container sees it. Docker's default bridge lives
# in 172.16.0.0/12, which is what the compose file falls back to.
TRUSTED_PROXIES="172.16.0.0/12"

# Delivers the sign-in link, the only way back in when Bring! is unreachable.
# null://null throws it away.
MAILER_DSN="smtp://user:pass@mail.example.de:587"
MAIL_FROM="no-reply@bring.example.de"

# Footer links. Each one takes either an address elsewhere or the path to a
# Markdown file we render and serve ourselves. A relative path is read from the
# application directory. Empty leaves the link out.
#   PRIVACY_POLICY_URL="https://example.com/privacy"
#   PRIVACY_POLICY_URL="legal/privacy.md"
PRIVACY_POLICY_URL=""
IMPRINT_URL=""

# Markdown appended to the end of every outgoing email, as a signature.
# A path, read relative to the application directory like the two above.
# Empty sends mail unsigned.
#   MAIL_SIGNATURE="legal/signature.md"
MAIL_SIGNATURE=""

# Hour of the day, UTC, at which the cron container prunes dormant accounts
# and clears expired tokens.
MAINTENANCE_HOUR="4"

CREDENTIALS_CACHE_TTL="900"
