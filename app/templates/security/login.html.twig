{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    {% embed 'wizard/_layout.html.twig' with {current_step: 1} %}
        {% block form %}
            <h1 class="text-xl font-semibold tracking-tight">{{ 'login.heading'|trans }}</h1>
            <p class="mt-2 text-sm text-slate-600">{{ 'login.lead'|trans }}</p>

            {% if error %}
                <div class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="mt-6">
                <div class="mb-5">
                    <label for="username" class="mb-1 block text-sm font-medium text-slate-700">{{ 'login.email'|trans }}</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}"
                           autocomplete="username" required autofocus
                           class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-xs outline-none placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200">
                </div>

                <div class="mb-6">
                    <label for="password" class="mb-1 block text-sm font-medium text-slate-700">{{ 'login.password'|trans }}</label>
                    <input type="password" id="password" name="_password"
                           autocomplete="current-password" required
                           class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-xs outline-none placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200">
                    <p class="mt-1.5 text-sm text-slate-500">{{ 'login.password_help'|trans }}</p>
                </div>

                {# data-controller lazy-loads assets/controllers/csrf_protection_controller.js,
                   which upgrades the stateless token to a double-submit cookie. Without
                   JavaScript the same-origin check still applies. #}
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                       value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="w-full rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">
                    {{ 'login.submit'|trans }}
                </button>
            </form>

            <details class="mt-6 border-t border-slate-100 pt-5" {{ error ? 'open' : '' }}>
                <summary class="cursor-pointer text-sm font-medium text-slate-900">
                    {{ 'login.link.summary'|trans }}
                </summary>

                <p class="mt-3 text-sm text-slate-600">{{ 'login.link.lead'|trans }}</p>

                <form method="post" action="{{ path('app_login_link') }}" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('login_link') }}">
                    <label for="link-email" class="mb-1 block text-sm font-medium text-slate-700">{{ 'login.link.email'|trans }}</label>
                    <input type="email" id="link-email" name="email" value="{{ last_username }}" required
                           class="mb-4 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-xs outline-none placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200">
                    <button type="submit"
                            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                        {{ 'login.link.submit'|trans }}
                    </button>
                </form>
            </details>
        {% endblock %}
    {% endembed %}
{% endblock %}
