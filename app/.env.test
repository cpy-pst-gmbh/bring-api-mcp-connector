# Fixtures for the test suite, not secrets: nothing outside `bin/phpunit`
# reads this file. The suite is unit tests today and boots no kernel, so
# KERNEL_CLASS is all it needs — a WebTestCase would additionally want
# DATABASE_URL, BRING_CREDENTIALS_KEY and the OAUTH_* values.
KERNEL_CLASS='App\Kernel'
APP_SECRET='not-a-secret-only-the-test-suite-reads-this'
