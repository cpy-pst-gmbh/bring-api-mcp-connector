{#
  The product mark: "MCP to" plus a shopping trolley.

  Inlined rather than loaded through `<img>` because the wordmark is set in
  live text, not outlines — an `<img>` renders in its own document, where the
  page's @font-face does not reach and Inter would silently fall back to
  Helvetica. Same reasoning as the icons next door.

  The two colours are the brand's `--color-ink` and `--color-sage`; they
  are written as tokens so a change to the palette carries here too. The
  fallbacks are the literal values from the supplied file.

  Decorative: the link around it carries the accessible name.
#}
<svg class="{{ class|default('h-14 w-auto') }}" viewBox="0 0 203 58"
     xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
    <text y="46.5" font-size="48" font-family="Inter, Helvetica, sans-serif"
          fill="var(--color-ink, #262730)">
        <tspan x="0" font-weight="700" letter-spacing="-1.44">MCP</tspan>
        <tspan x="110.03" font-weight="400" letter-spacing="-2.4"
               fill="var(--color-sage, #A1B0AB)">to</tspan>
    </text>
    <g transform="translate(144.45 0) scale(0.58)"
       stroke="var(--color-ink, #262730)" fill="var(--color-ink, #262730)">
        <path d="M6 18 H 20 L 32 62" stroke-width="7" stroke-linecap="butt"
              stroke-linejoin="miter" fill="none" />
        <path d="M26 32 H 88 L 77 60 H 36 Z" stroke-width="3.5" stroke-linejoin="round" />
        <circle cx="43" cy="74.9" r="7.6" stroke="none" />
        <circle cx="73" cy="74.9" r="7.6" stroke="none" />
    </g>
</svg>
