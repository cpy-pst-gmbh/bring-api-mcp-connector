{#
  The create-connector form. Step 2 renders it inline, because filling it in is
  the step; step 3 puts the same markup in a dialog for adding another one.
#}
<form method="post" action="{{ path('app_connector_create') }}" class="flex flex-col gap-6">
    <input type="hidden" name="_token" value="{{ csrf_token('create_connector') }}">

    <div>
        <label for="{{ id_prefix }}-label" class="mb-2 block text-[15px] font-medium text-ink">
            {{ 'connector.modal.name'|trans }}
        </label>
        <input type="text" id="{{ id_prefix }}-label" name="label"
               placeholder="{{ 'connector.modal.name_placeholder'|trans }}" maxlength="60"
               class="block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none placeholder:text-ink-300 focus:border-pink focus:ring-2 focus:ring-pink-100">
    </div>

    <div>
        <label for="{{ id_prefix }}-list" class="mb-2 block text-[15px] font-medium text-ink">
            {{ 'connector.modal.list'|trans }}
        </label>
        {% if list_names is null %}
            <input type="text" id="{{ id_prefix }}-list" name="default_list" maxlength="120"
                   placeholder="{{ 'connector.modal.list_placeholder'|trans }}"
                   class="block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none placeholder:text-ink-300 focus:border-pink focus:ring-2 focus:ring-pink-100">
            <p class="mt-2.5 text-[15px] leading-normal text-ink-500">{{ 'connector.modal.list_help_offline'|trans }}</p>
        {% else %}
            <select id="{{ id_prefix }}-list" name="default_list"
                    class="block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none focus:border-pink focus:ring-2 focus:ring-pink-100">
                <option value="">{{ 'connector.modal.list_first'|trans }}</option>
                {% for name in list_names %}
                    <option value="{{ name }}">{{ name }}</option>
                {% endfor %}
            </select>
            <p class="mt-2.5 text-[15px] leading-normal text-ink-500">{{ 'connector.modal.list_help'|trans }}</p>
        {% endif %}
    </div>

    {% block actions %}
        <div>
            <button type="submit"
                    class="rounded-action bg-pink px-7 py-4 text-base font-bold text-white shadow-pink transition-opacity duration-300 hover:opacity-80 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                {{ 'connector.modal.submit'|trans }}
            </button>
        </div>
    {% endblock %}
</form>
