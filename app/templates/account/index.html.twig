{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block body %}
    {% embed 'wizard/_layout.html.twig' with {current_step: current_step} %}
        {% block form %}
            {% if consent_pending %}
                <div class="mb-6 rounded-action bg-tint px-5 py-4 text-[15px] text-ink shadow-e1">
                    {{ 'account.consent_pending'|trans }}
                    <a href="{{ path('app_consent') }}" class="font-bold underline underline-offset-4 transition-colors duration-300 hover:text-pink">
                        {{ 'account.consent_continue'|trans }}
                    </a>.
                </div>
            {% endif %}

            {% if current_step == 2 %}
                {# Nothing set up yet, so the form is the step. #}
                <h1 class="text-[26px] font-normal leading-tight tracking-tight">
                    {{ 'connector.heading_html'|trans|raw }}
                </h1>
                <p class="mt-3 text-base leading-relaxed text-ink-700">{{ 'connector.lead'|trans }}</p>

                <div class="mt-8">
                    {{ include('account/_connector_form.html.twig', {id_prefix: 'connector'}) }}
                </div>
            {% else %}
                <h1 class="text-[26px] font-normal leading-tight tracking-tight">{{ 'claude.heading_html'|trans|raw }}</h1>
                <p class="mt-3 text-base leading-relaxed text-ink-700">{{ 'claude.lead'|trans }}</p>

                {% if connectors|length > 1 %}
                    {# More than one, so which set of credentials is on screen
                       has to be a choice. A GET form rather than script: the
                       selection survives a reload and can be bookmarked, and
                       without JavaScript the submit button still works. #}
                    <form method="get" action="{{ path('app_account') }}"
                          class="mt-8 flex flex-wrap items-end gap-4"
                          data-controller="auto-submit">
                        <div class="grow">
                            <label for="connector-select" class="mb-2 block text-[15px] font-medium text-ink">
                                {{ 'claude.choose'|trans }}
                            </label>
                            <select id="connector-select" name="connector"
                                    data-action="change->auto-submit#submit"
                                    class="block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none focus:border-pink focus:ring-2 focus:ring-pink-100">
                                {% for connector in connectors %}
                                    <option value="{{ connector.identifier }}"
                                            {{ connector.identifier == selected.identifier ? 'selected' : '' }}>
                                        {{ connector.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <button type="submit" data-auto-submit-target="fallback"
                                class="rounded-control border border-ink-100 bg-white px-5 py-3.5 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                            {{ 'claude.choose_submit'|trans }}
                        </button>
                    </form>
                {% endif %}

                <dl class="mt-8 space-y-6">
                    <div>
                        <dt class="text-[15px] font-medium text-ink">{{ 'claude.endpoint'|trans }}</dt>
                        <dd class="mt-2.5">
                            {% if mcp_endpoint %}
                                <code class="block overflow-x-auto rounded-action bg-tint p-4 font-mono text-[15px] text-ink shadow-inset-field">{{ mcp_endpoint }}</code>
                            {% else %}
                                <p class="text-[15px] text-pink-700">{{ 'claude.endpoint_missing'|trans }}</p>
                            {% endif %}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-[15px] font-medium text-ink">{{ 'claude.client_id'|trans }}</dt>
                        <dd class="mt-2.5">
                            <code id="client-id" class="block overflow-x-auto rounded-action bg-tint p-4 font-mono text-[15px] text-ink shadow-inset-field">{{ selected.identifier }}</code>
                            <p class="mt-2.5 text-[15px] leading-normal text-ink-500">{{ 'claude.client_id_help'|trans }}</p>
                        </dd>
                    </div>
                </dl>

                <p class="mt-6 text-[15px] leading-normal text-ink-500">
                    {{ 'claude.writes_to'|trans({
                        '%list%': selected.defaultListName ?? 'claude.writes_to_first'|trans,
                    }) }}
                </p>

                <div class="mt-8 flex flex-wrap items-center gap-5 border-t border-sage-100 pt-6"
                     data-controller="modal">
                    <button type="button" data-action="modal#open"
                            class="rounded-control border border-ink-100 bg-white px-5 py-3.5 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                        {{ 'claude.add_another'|trans }}
                    </button>

                    <form method="post" action="{{ path('app_connector_revoke', {identifier: selected.identifier}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('revoke_connector_' ~ selected.identifier) }}">
                        <button type="submit"
                                class="text-[15px] font-medium text-pink-700 underline underline-offset-4 transition-opacity duration-300 hover:opacity-80">
                            {{ 'connector.revoke'|trans }}
                        </button>
                    </form>

                    {# Only applies when scripting is off, where the dialog would
                       never be opened: it then renders as a plain block. #}
                    <noscript>
                        <style>
                            dialog[data-modal-target="dialog"] {
                                display: block;
                                position: static;
                                margin-top: 1.5rem;
                            }
                        </style>
                    </noscript>

                    {# m-auto restores the centering the UA stylesheet gives a
                       modal dialog — Tailwind's preflight resets margins to 0. #}
                    <dialog id="connector-dialog" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop"
                            class="m-auto w-full max-w-md rounded-card bg-white p-8 shadow-dialog backdrop:bg-ink/40">
                        {{ include('dialog/_header.html.twig', {heading: 'connector.modal.heading'|trans}) }}

                        <div class="mt-6">
                            {% embed 'account/_connector_form.html.twig' with {id_prefix: 'modal-connector'} %}
                                {% block actions %}
                                    <div class="flex justify-end gap-4">
                                        <button type="button" data-action="modal#close"
                                                class="rounded-control border border-ink-100 bg-white px-5 py-3.5 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                                            {{ 'connector.modal.cancel'|trans }}
                                        </button>
                                        <button type="submit"
                                                class="rounded-action bg-pink px-6 py-3.5 text-[15px] font-bold text-white shadow-pink transition-opacity duration-300 hover:opacity-80 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                                            {{ 'connector.modal.submit'|trans }}
                                        </button>
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        </div>
                    </dialog>
                </div>
            {% endif %}
        {% endblock %}

        {% block below %}
            <section class="mt-10 rounded-card bg-white shadow-e2">
                <h2 class="flex items-center gap-3 border-b border-sage-100 px-8 py-6 text-[15px] font-bold text-ink">
                    {{ include('icon/settings.html.twig', {class: 'size-5 text-sage'}) }}
                    {{ 'settings.heading'|trans }}
                </h2>

                <div class="divide-y divide-sage-100">
                    <div class="flex flex-wrap items-center justify-between gap-6 px-8 py-6"
                         data-controller="modal">
                        <div class="min-w-0">
                            <p class="text-base font-bold text-ink">{{ 'account.password.heading'|trans }}</p>
                            <p class="mt-1.5 text-[15px] leading-normal text-ink-500">{{ 'account.password.lead'|trans }}</p>
                        </div>

                        <button type="button" data-action="modal#open"
                                class="shrink-0 rounded-control border border-ink-100 bg-white px-5 py-3 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                            {{ 'account.password.button'|trans }}
                        </button>

                        <noscript>
                            <style>
                                dialog[data-modal-target="dialog"] {
                                    display: block;
                                    position: static;
                                    margin-top: 1.5rem;
                                }
                            </style>
                        </noscript>

                        {# Rendered open when the submission came back with
                           errors, so they are not lost behind a closed dialog;
                           the controller turns that into a real modal. #}
                        <dialog id="password-dialog" data-modal-target="dialog"
                                data-action="click->modal#closeOnBackdrop"
                                {{ form.vars.submitted and not form.vars.valid ? 'open' : '' }}
                                class="m-auto w-full max-w-md rounded-card bg-white p-8 shadow-dialog backdrop:bg-ink/40">
                            {{ include('dialog/_header.html.twig', {heading: 'account.password.heading'|trans}) }}
                            <p class="mt-4 text-base leading-relaxed text-ink-700">{{ 'account.password.lead'|trans }}</p>
                            <p class="mt-3 text-sm text-ink-300">
                                {{ 'account.password.updated_at'|trans({'%date%': credential.updatedAt|date('Y-m-d H:i')}) }}
                            </p>

                            <div class="mt-6">
                                {{ form_start(form) }}
                                    {{ form_row(form.plainPassword) }}

                                    <div class="mt-7 flex justify-end gap-4">
                                        <button type="button" data-action="modal#close"
                                                class="rounded-control border border-ink-100 bg-white px-5 py-3.5 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                                            {{ 'account.password.cancel'|trans }}
                                        </button>
                                        <button type="submit"
                                                class="rounded-action bg-pink px-6 py-3.5 text-[15px] font-bold text-white shadow-pink transition-opacity duration-300 hover:opacity-80 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                                            {{ 'account.password.submit'|trans }}
                                        </button>
                                    </div>
                                {{ form_end(form) }}
                            </div>
                        </dialog>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-6 px-8 py-6"
                         data-controller="modal">
                        <div class="min-w-0">
                            <p class="text-base font-bold text-ink">{{ 'account.delete.heading'|trans }}</p>
                            <p class="mt-1.5 text-[15px] leading-normal text-ink-500">{{ 'account.delete.lead'|trans }}</p>
                        </div>

                        <button type="button" data-action="modal#open"
                                class="shrink-0 rounded-control border border-pink-300 bg-white px-5 py-3 text-[15px] font-medium text-pink-700 shadow-e1 transition-colors duration-300 hover:bg-pink-100 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                            {{ 'account.delete.button'|trans }}
                        </button>

                        <noscript>
                            <style>
                                dialog[data-modal-target="dialog"] {
                                    display: block;
                                    position: static;
                                    margin-top: 1.5rem;
                                }
                            </style>
                        </noscript>

                        <dialog id="delete-account-dialog" data-modal-target="dialog"
                                data-action="click->modal#closeOnBackdrop"
                                class="m-auto w-full max-w-md rounded-card bg-white p-8 shadow-dialog backdrop:bg-ink/40">
                            {{ include('dialog/_header.html.twig', {heading: 'account.delete.modal.heading'|trans}) }}
                            <p class="mt-4 text-base leading-relaxed text-ink-700">{{ 'account.delete.modal.body'|trans }}</p>

                            <form method="post" action="{{ path('app_account_delete') }}" class="mt-7 flex justify-end gap-4">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
                                <button type="button" data-action="modal#close"
                                        class="rounded-control border border-ink-100 bg-white px-5 py-3.5 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                                    {{ 'account.delete.modal.cancel'|trans }}
                                </button>
                                <button type="submit"
                                        class="rounded-action bg-ink px-6 py-3.5 text-[15px] font-bold text-white shadow-e2 transition-opacity duration-300 hover:opacity-80 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                                    {{ 'account.delete.modal.confirm'|trans }}
                                </button>
                            </form>
                        </dialog>
                    </div>
                </div>
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
