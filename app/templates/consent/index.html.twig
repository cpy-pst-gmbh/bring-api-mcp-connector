{% extends 'base.html.twig' %}

{% block title %}{{ 'consent.title'|trans }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <h1 class="text-2xl font-semibold tracking-tight">
            {{ 'consent.heading'|trans({'%client%': client_name}) }}
        </h1>
        <p class="mt-2 text-slate-600">
            {{ 'consent.lead'|trans({
                '%client%': client_name,
                '%email%': app.user.userIdentifier,
            }) }}
        </p>

        <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-xs">
            <h2 class="text-sm font-medium text-slate-900">{{ 'consent.permissions_heading'|trans }}</h2>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li class="flex gap-2"><span aria-hidden="true">·</span> {{ 'consent.permission_read'|trans }}</li>
                <li class="flex gap-2"><span aria-hidden="true">·</span> {{ 'consent.permission_write'|trans }}</li>
            </ul>

            <p class="mt-4 text-xs text-slate-400">
                {{ 'consent.scopes'|trans({'%count%': scopes|length, '%scopes%': scopes|join(', ')}) }}
            </p>

            {# Both decisions redirect to claude.ai. Turbo would submit this with
               fetch(), and a fetch cannot follow a redirect to another origin —
               the browser blocks it as a CORS failure and the connector never
               receives its code. A plain form submission navigates instead. #}
            <form method="post" data-turbo="false" class="mt-6 flex gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('consent') }}">
                <button type="submit" name="decision" value="approve"
                        class="flex-1 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">
                    {{ 'consent.allow'|trans }}
                </button>
                <button type="submit" name="decision" value="deny"
                        class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                    {{ 'consent.deny'|trans }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}
