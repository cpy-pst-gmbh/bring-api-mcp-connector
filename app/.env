# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Signs the login links and keys the login rate limiter. Empty here on
# purpose: no secret belongs in a committed file. Put a value into
# .env.local for development ("openssl rand -hex 16"); in a container the
# environment supplies it and the entrypoint refuses to start without it.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> league/oauth2-server-bundle ###
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/jwt/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Both empty for the same reason as APP_SECRET. The passphrase protects
# config/jwt/private.pem and has to stay the value the keypair was
# generated with; the encryption key protects authorization codes and
# refresh token payloads. "openssl rand -hex 16" for each.
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=
###< league/oauth2-server-bundle ###

###> app ###
# Headers Bring! expects. The API key is the one bring-api uses publicly; it
# identifies the client, not the user. Change these only if Bring does.
BRING_API_BASE_URL=https://api.getbring.com/rest/
BRING_API_KEY=cof4Nc6D8saplXjE3h3HXqHH8m7VU2i1Gs0g85Sp
BRING_CLIENT=android
BRING_APPLICATION=bring
BRING_COUNTRY=DE
# Encrypts the stored Bring! passwords. 32 random bytes, base64-encoded;
# generate one with "php bin/console app:credentials:generate-key" and
# keep it in .env.local. Rotating it makes every stored password
# unreadable, so back it up together with the database.
BRING_CREDENTIALS_KEY=
# Where the cron container writes the daily database copy, and how many copies
# it keeps. Empty writes to var/backups, which is fine for a checkout and wrong
# in a container — the compose file points it at a volume instead.
BACKUP_DIR=
BACKUP_KEEP=7
###< app ###

# Public URL of the MCP server, shown on the account page so users can
# paste it into Claude. Leave empty to hide that hint.
MCP_ENDPOINT=
# Where /health reaches the MCP server. Empty derives it from MCP_ENDPOINT;
# set it to the container address to skip the round trip through the proxy.
MCP_HEALTH_URL=
# Reverse proxies whose forwarded headers may be believed. Empty trusts none,
# which is right when nothing sits in front. Behind Apache in Docker this is
# the proxy's address or the container network, e.g. 172.16.0.0/12.
TRUSTED_PROXIES=
# Footer links. Each one takes either an address elsewhere (http:// or
# https://) or the path to a Markdown file, which is rendered and served from
# /privacy and /imprint. A relative path is read from the project directory.
# An empty value leaves the link out of the footer entirely.
PRIVACY_POLICY_URL=
IMPRINT_URL=
# Markdown appended to the end of every outgoing email, as a signature. A path,
# relative to the project directory. Empty sends mail unsigned.
MAIL_SIGNATURE=
# Callback Claude returns to. Only change if Anthropic changes theirs.
#CONNECTOR_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback

###> symfony/mailer ###
# null://null discards mail. In dev the profiler still shows the message,
# so the login link is readable there.
MAILER_DSN=null://null
MAIL_FROM=no-reply@localhost
###< symfony/mailer ###
