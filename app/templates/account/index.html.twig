{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block body %}
    {% embed 'wizard/_layout.html.twig' with {current_step: current_step} %}
        {% block form %}
            {% if consent_pending %}
                <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                    {{ 'account.consent_pending'|trans }}
                    <a href="{{ path('app_consent') }}" class="font-medium underline underline-offset-4">
                        {{ 'account.consent_continue'|trans }}
                    </a>.
                </div>
            {% endif %}

            {% if current_step == 2 %}
                {# Nothing set up yet, so the form is the step. #}
                <h1 class="text-xl font-semibold tracking-tight">
                    {{ 'wizard.step.connector.title'|trans }}
                </h1>
                <p class="mt-2 text-sm text-slate-600">{{ 'connector.lead'|trans }}</p>

                <div class="mt-6">
                    {{ include('account/_connector_form.html.twig', {id_prefix: 'connector'}) }}
                </div>
            {% else %}
                <h1 class="text-xl font-semibold tracking-tight">{{ 'claude.heading'|trans }}</h1>
                <p class="mt-2 text-sm text-slate-600">{{ 'claude.lead'|trans }}</p>

                {% if connectors|length > 1 %}
                    {# More than one, so which set of credentials is on screen
                       has to be a choice. A GET form rather than script: the
                       selection survives a reload and can be bookmarked, and
                       without JavaScript the submit button still works. #}
                    <form method="get" action="{{ path('app_account') }}"
                          class="mt-6 flex flex-wrap items-end gap-3"
                          data-controller="auto-submit">
                        <div class="grow">
                            <label for="connector-select" class="mb-1 block text-sm font-medium text-slate-700">
                                {{ 'claude.choose'|trans }}
                            </label>
                            <select id="connector-select" name="connector"
                                    data-action="change->auto-submit#submit"
                                    class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-xs outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200">
                                {% for connector in connectors %}
                                    <option value="{{ connector.identifier }}"
                                            {{ connector.identifier == selected.identifier ? 'selected' : '' }}>
                                        {{ connector.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <button type="submit" data-auto-submit-target="fallback"
                                class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                            {{ 'claude.choose_submit'|trans }}
                        </button>
                    </form>
                {% endif %}

                <dl class="mt-6 space-y-4">
                    <div>
                        <dt class="text-sm font-medium text-slate-700">{{ 'claude.endpoint'|trans }}</dt>
                        <dd class="mt-1">
                            {% if mcp_endpoint %}
                                <code class="block overflow-x-auto rounded-lg bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800">{{ mcp_endpoint }}</code>
                            {% else %}
                                <p class="text-sm text-amber-700">{{ 'claude.endpoint_missing'|trans }}</p>
                            {% endif %}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-sm font-medium text-slate-700">{{ 'claude.client_id'|trans }}</dt>
                        <dd class="mt-1">
                            <code id="client-id" class="block overflow-x-auto rounded-lg bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800">{{ selected.identifier }}</code>
                            <p class="mt-1.5 text-sm text-slate-500">{{ 'claude.client_id_help'|trans }}</p>
                        </dd>
                    </div>
                </dl>

                <p class="mt-4 text-sm text-slate-500">
                    {{ 'claude.writes_to'|trans({
                        '%list%': selected.defaultListName ?? 'claude.writes_to_first'|trans,
                    }) }}
                </p>

                <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-5"
                     data-controller="modal">
                    <button type="button" data-action="modal#open"
                            class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                        {{ 'claude.add_another'|trans }}
                    </button>

                    <form method="post" action="{{ path('app_connector_revoke', {identifier: selected.identifier}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('revoke_connector_' ~ selected.identifier) }}">
                        <button type="submit"
                                class="text-sm font-medium text-red-600 underline-offset-4 hover:underline">
                            {{ 'connector.revoke'|trans }}
                        </button>
                    </form>

                    {# Only applies when scripting is off, where the dialog would
                       never be opened: it then renders as a plain block. #}
                    <noscript>
                        <style>
                            dialog[data-modal-target="dialog"] {
                                display: block;
                                position: static;
                                margin-top: 1.5rem;
                            }
                        </style>
                    </noscript>

                    {# m-auto restores the centering the UA stylesheet gives a
                       modal dialog — Tailwind's preflight resets margins to 0. #}
                    <dialog id="connector-dialog" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop"
                            class="m-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-lg backdrop:bg-slate-900/40">
                        {{ include('dialog/_header.html.twig', {heading: 'connector.modal.heading'|trans}) }}

                        <div class="mt-5">
                            {% embed 'account/_connector_form.html.twig' with {id_prefix: 'modal-connector'} %}
                                {% block actions %}
                                    <div class="mt-6 flex justify-end gap-3">
                                        <button type="button" data-action="modal#close"
                                                class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                                            {{ 'connector.modal.cancel'|trans }}
                                        </button>
                                        <button type="submit"
                                                class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">
                                            {{ 'connector.modal.submit'|trans }}
                                        </button>
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        </div>
                    </dialog>
                </div>
            {% endif %}
        {% endblock %}

        {% block below %}
            <section class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm">
                <h2 class="flex items-center gap-2 border-b border-slate-100 px-6 py-4 text-sm font-semibold text-slate-900">
                    {{ include('icon/settings.html.twig', {class: 'size-5 text-slate-400'}) }}
                    {{ 'settings.heading'|trans }}
                </h2>

                <div class="divide-y divide-slate-100">
                    <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-4"
                         data-controller="modal">
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-slate-900">{{ 'account.password.heading'|trans }}</p>
                            <p class="mt-1 text-sm text-slate-500">{{ 'account.password.lead'|trans }}</p>
                        </div>

                        <button type="button" data-action="modal#open"
                                class="shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                            {{ 'account.password.button'|trans }}
                        </button>

                        <noscript>
                            <style>
                                dialog[data-modal-target="dialog"] {
                                    display: block;
                                    position: static;
                                    margin-top: 1.5rem;
                                }
                            </style>
                        </noscript>

                        {# Rendered open when the submission came back with
                           errors, so they are not lost behind a closed dialog;
                           the controller turns that into a real modal. #}
                        <dialog id="password-dialog" data-modal-target="dialog"
                                data-action="click->modal#closeOnBackdrop"
                                {{ form.vars.submitted and not form.vars.valid ? 'open' : '' }}
                                class="m-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-lg backdrop:bg-slate-900/40">
                            {{ include('dialog/_header.html.twig', {heading: 'account.password.heading'|trans}) }}
                            <p class="mt-3 text-sm text-slate-600">{{ 'account.password.lead'|trans }}</p>
                            <p class="mt-3 text-xs text-slate-400">
                                {{ 'account.password.updated_at'|trans({'%date%': credential.updatedAt|date('Y-m-d H:i')}) }}
                            </p>

                            <div class="mt-5">
                                {{ form_start(form) }}
                                    {{ form_row(form.plainPassword) }}

                                    <div class="mt-6 flex justify-end gap-3">
                                        <button type="button" data-action="modal#close"
                                                class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                                            {{ 'account.password.cancel'|trans }}
                                        </button>
                                        <button type="submit"
                                                class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">
                                            {{ 'account.password.submit'|trans }}
                                        </button>
                                    </div>
                                {{ form_end(form) }}
                            </div>
                        </dialog>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-4"
                         data-controller="modal">
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-slate-900">{{ 'account.delete.heading'|trans }}</p>
                            <p class="mt-1 text-sm text-slate-500">{{ 'account.delete.lead'|trans }}</p>
                        </div>

                        <button type="button" data-action="modal#open"
                                class="shrink-0 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-300 focus:ring-offset-2">
                            {{ 'account.delete.button'|trans }}
                        </button>

                        <noscript>
                            <style>
                                dialog[data-modal-target="dialog"] {
                                    display: block;
                                    position: static;
                                    margin-top: 1.5rem;
                                }
                            </style>
                        </noscript>

                        <dialog id="delete-account-dialog" data-modal-target="dialog"
                                data-action="click->modal#closeOnBackdrop"
                                class="m-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-lg backdrop:bg-slate-900/40">
                            {{ include('dialog/_header.html.twig', {heading: 'account.delete.modal.heading'|trans}) }}
                            <p class="mt-3 text-sm text-slate-600">{{ 'account.delete.modal.body'|trans }}</p>

                            <form method="post" action="{{ path('app_account_delete') }}" class="mt-6 flex justify-end gap-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
                                <button type="button" data-action="modal#close"
                                        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2">
                                    {{ 'account.delete.modal.cancel'|trans }}
                                </button>
                                <button type="submit"
                                        class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2">
                                    {{ 'account.delete.modal.confirm'|trans }}
                                </button>
                            </form>
                        </dialog>
                    </div>
                </div>
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
