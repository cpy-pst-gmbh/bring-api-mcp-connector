# --- Shared ---

# Public HTTPS address of the Symfony app (authorization server and web UI),
# without a trailing slash.
BASE_URL="https://bring.example.de"

# Public HTTPS address of the MCP server, without a trailing slash.
# Claude connects to <MCP_BASE_URL>/mcp.
MCP_BASE_URL="https://bring-mcp.example.de"

# --- Symfony app ---

# php bin/console app:credentials:generate-key
BRING_CREDENTIALS_KEY=""
APP_SECRET=""
OAUTH_PASSPHRASE=""
OAUTH_ENCRYPTION_KEY=""

# Reverse proxies whose forwarded headers may be believed. Without this the app
# believes it is reached at http://app:8000 and puts that into the discovery
# documents and the login links.
TRUSTED_PROXIES="172.16.0.0/12"

# Delivers the sign-in link. null://null discards it.
MAILER_DSN="null://null"
MAIL_FROM="no-reply@bring.example.de"

# Footer links. Each one takes either an address elsewhere or the path to a
# Markdown file we render and serve ourselves. A relative path is read from the
# application directory. Empty leaves the link out.
#   PRIVACY_POLICY_URL="https://example.com/privacy"
#   PRIVACY_POLICY_URL="legal/privacy.md"
PRIVACY_POLICY_URL=""
IMPRINT_URL=""

# Markdown appended to the end of every outgoing email, as a signature.
# A path, read relative to the application directory like the two above.
# Empty sends mail unsigned.
#   MAIL_SIGNATURE="legal/signature.md"
MAIL_SIGNATURE=""

# --- MCP server ---

# Where the MCP container reaches Symfony for JWKS and credentials. With
# docker-compose this is the service address; it is set there already.
# AUTH_SERVER_INTERNAL_URL="http://app:8000"


# Optional. Every user mints their own connector client, and league puts the
# client identifier in the token's `aud` claim — so there is normally no single
# value to pin and this stays empty. Set it only for a single shared client.
OAUTH_AUDIENCE=""

# How long a logged-in Bring session is reused before the credentials are
# fetched again, in seconds.
CREDENTIALS_CACHE_TTL="900"
