# Runtime state lives in volumes; a stale copy from the working tree would be
# baked into the image and then shadowed anyway.
var/
vendor/
public/assets/
public/bundles/
assets/vendor/

# Local overrides never belong in an image.
.env.local
.env.*.local

# .env itself stays: Symfony's Dotenv throws PathException when it is missing,
# so an image without it does not boot at all. It carries defaults only —
# every secret slot in it is empty and the environment fills them in.

# The test suite and its configuration. composer installs without dev
# dependencies, so none of this could run in the image anyway.
tests/
phpunit.dist.xml
.phpunit.cache/
.env.test

# Secrets: the keypair is generated on first start into a volume.
config/jwt/

.git/
.idea/
