{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    {% embed 'wizard/_layout.html.twig' with {current_step: 1} %}
        {% block form %}
            <h1 class="text-[26px] font-normal leading-tight tracking-tight">{{ 'login.heading_html'|trans|raw }}</h1>
            <p class="mt-3 text-base leading-relaxed text-ink-700">{{ 'login.lead'|trans }}</p>

            {% if error %}
                <div class="mt-6 rounded-action bg-pink-100 px-5 py-4 text-[15px] text-pink-700 shadow-e1">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="mt-8 flex flex-col gap-6">
                <div>
                    <label for="username" class="mb-2 block text-[15px] font-medium text-ink">{{ 'login.email'|trans }}</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}"
                           autocomplete="username" required autofocus
                           class="block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none placeholder:text-ink-300 focus:border-pink focus:ring-2 focus:ring-pink-100">
                </div>

                <div>
                    <label for="password" class="mb-2 block text-[15px] font-medium text-ink">{{ 'login.password'|trans }}</label>
                    <input type="password" id="password" name="_password"
                           autocomplete="current-password" required
                           class="block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none placeholder:text-ink-300 focus:border-pink focus:ring-2 focus:ring-pink-100">
                    <p class="mt-2.5 text-[15px] leading-normal text-ink-500">{{ 'login.password_help'|trans }}</p>
                </div>

                {# data-controller lazy-loads assets/controllers/csrf_protection_controller.js,
                   which upgrades the stateless token to a double-submit cookie. Without
                   JavaScript the same-origin check still applies. #}
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                       value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="w-full rounded-action bg-pink px-5 py-4 text-base font-bold text-white shadow-pink transition-opacity duration-300 hover:opacity-80 focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                    {{ 'login.submit'|trans }}
                </button>
            </form>

            <details class="mt-8 border-t border-sage-100 pt-6" {{ error ? 'open' : '' }}>
                <summary class="cursor-pointer text-[15px] font-medium text-ink transition-colors duration-300 hover:text-pink">
                    {{ 'login.link.summary'|trans }}
                </summary>

                <p class="mt-4 text-[15px] leading-normal text-ink-700">{{ 'login.link.lead'|trans }}</p>

                <form method="post" action="{{ path('app_login_link') }}" class="mt-5">
                    <input type="hidden" name="_token" value="{{ csrf_token('login_link') }}">
                    <label for="link-email" class="mb-2 block text-[15px] font-medium text-ink">{{ 'login.link.email'|trans }}</label>
                    <input type="email" id="link-email" name="email" value="{{ last_username }}" required
                           class="mb-5 block w-full rounded-control border border-ink-100 bg-white px-4 py-3.5 text-base text-ink shadow-inset-field outline-none placeholder:text-ink-300 focus:border-pink focus:ring-2 focus:ring-pink-100">
                    <button type="submit"
                            class="w-full rounded-control border border-ink-100 bg-white px-5 py-3.5 text-[15px] font-medium text-ink shadow-e1 transition-colors duration-300 hover:border-pink focus:outline-2 focus:outline-offset-2 focus:outline-pink">
                        {{ 'login.link.submit'|trans }}
                    </button>
                </form>
            </details>
        {% endblock %}
    {% endembed %}
{% endblock %}
